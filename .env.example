# Variables del frontend (Vite) — se hornean en el bundle, NO poner secretos aquí.
# Conexión al Supabase self-hosted en Contabo:
VITE_SUPABASE_URL=https://db.orbitacac.com
VITE_SUPABASE_ANON=eyJ...   # anon key (pública por diseño, protegida por RLS)
VITE_APP_URL=https://localhost:5173   # en prod: https://orbit.orbitacac.com

# NOTA: las keys de IA (Claude) y WhatsApp (GoHighLevel) ya NO viven en el frontend.
# Están server-side en las Edge Functions `extraer-datos` y `send-whatsapp`,
# leídas desde el .env del stack en el VPS (/opt/supabase/docker/.env):
#   CLAUDE_KEY, GHL_TOKEN, GHL_LOCATION_ID
