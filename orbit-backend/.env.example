# Copiar a .env en el servidor. PGPASSWORD y JWT_SECRET se toman del
# .env de Supabase (/opt/supabase/docker/.env). JOB_TOKEN: openssl rand -hex 24
PORT=8787
PGHOST=supabase-db
PGPORT=5432
PGUSER=postgres
PGDATABASE=postgres
PGPASSWORD=
JWT_SECRET=
JOB_TOKEN=

# Reportes Grupales (Fase 5) — los mismos secretos que ya usan las Edge Functions:
# GHL_*  → de la función send-whatsapp (Zolutium/GoHighLevel)
# CLAUDE_KEY → de la función extraer-datos (asistente IA)
GHL_TOKEN=
GHL_LOCATION_ID=
# Transporte de solicitudes de imágenes, seguimientos, digitales y certificados.
# Mantener GHL durante las pruebas. Cambiar a META solo después de verificar
# webhook + plantillas de la línea operativa. Un valor desconocido falla cerrado.
WHATSAPP_OPERATIONAL_TRANSPORT=GHL
# Token temporal y aislado para importar una sola línea desde Zolutium.
# Revocarlo y borrar estas variables cuando termine la migración.
ZOLUTIUM_IMPORT_TOKEN=
ZOLUTIUM_IMPORT_LOCATION_ID=
ZOLUTIUM_IMPORT_PHONE=
CLAUDE_KEY=
# Opcional: modelo IA (default claude-haiku-4-5)
# CLAUDE_MODEL=claude-haiku-4-5

# ── WhatsApp Cloud API — varias líneas aisladas por phone_number_id ─────────
# Estas variables van SOLO aquí (/opt/orbit-backend/.env), NUNCA en el .env de
# la raíz del repo: ese alimenta el bundle de Vite y el APP_SECRET terminaría
# publicado en el JavaScript del navegador.
#
# WHATSAPP_VERIFY_TOKEN: lo inventas tú y lo tecleas igual en el panel de Meta
#   al suscribir el webhook. Sirve una sola vez. Generar: openssl rand -hex 24
# WHATSAPP_APP_SECRET: Meta → tu app → Configuración → Básica → Clave secreta.
#   Con esto se valida que cada POST viene de verdad de Meta.
# WHATSAPP_ALLOWED_PHONE_IDS: phone_number_id autorizados, separados por coma.
#   ⚠️ Si queda vacío se descarta TODO (fail-closed, a propósito): así un .env
#   mal puesto nunca procesa números que siguen operando en Zolutium.
#   ¿No sabes el id? Conecta el webhook, manda un mensaje de prueba al número y
#   míralo en el log: docker logs orbit-backend | grep wa-webhook
# WHATSAPP_ACCESS_TOKEN / WHATSAPP_API_VERSION: bandeja, plantillas y transporte
#   directo. Cada agente guarda su WABA y sus phone_number_ids en PostgreSQL.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWED_PHONE_IDS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v26.0

# Memoriales (Remotion self-host) — el video se guarda en el volumen memorial_data.
# MEMORIAL_DATA_DIR=/data/memoriales          # default (montado por docker-compose)
# MEMORIAL_SIGN_SECRET=                        # firma enlaces de archivo; default = JWT_SECRET
# MEMORIAL_CONCURRENCY=2                        # hilos de render de Remotion
