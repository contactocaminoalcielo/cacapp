# Copiar a .env en el servidor. PGPASSWORD y JWT_SECRET se toman del
# .env de Supabase (/opt/supabase/docker/.env). JOB_TOKEN: openssl rand -hex 24
PORT=8787
PGHOST=supabase-db
PGPORT=5432
PGUSER=postgres
PGDATABASE=postgres
PGPASSWORD=
JWT_SECRET=
JOB_TOKEN=

# Reportes Grupales (Fase 5) — los mismos secretos que ya usan las Edge Functions:
# GHL_*  → de la función send-whatsapp (Zolutium/GoHighLevel)
# CLAUDE_KEY → de la función extraer-datos (asistente IA)
GHL_TOKEN=
GHL_LOCATION_ID=
CLAUDE_KEY=
# Opcional: modelo IA (default claude-haiku-4-5)
# CLAUDE_MODEL=claude-haiku-4-5

# Memoriales (Remotion self-host) — el video se guarda en el volumen memorial_data.
# MEMORIAL_DATA_DIR=/data/memoriales          # default (montado por docker-compose)
# MEMORIAL_SIGN_SECRET=                        # firma enlaces de archivo; default = JWT_SECRET
# MEMORIAL_CONCURRENCY=2                        # hilos de render de Remotion
