# Copiar a .env en el servidor. PGPASSWORD y JWT_SECRET se toman del
# .env de Supabase (/opt/supabase/docker/.env). JOB_TOKEN: openssl rand -hex 24
PORT=8787
PGHOST=supabase-db
PGPORT=5432
PGUSER=postgres
PGDATABASE=postgres
PGPASSWORD=
JWT_SECRET=
JOB_TOKEN=

# Reportes Grupales (Fase 5) — los mismos secretos que ya usan las Edge Functions:
# GHL_*  → de la función send-whatsapp (Zolutium/GoHighLevel)
# CLAUDE_KEY → de la función extraer-datos (asistente IA)
GHL_TOKEN=
GHL_LOCATION_ID=
CLAUDE_KEY=
# Opcional: modelo IA (default claude-haiku-4-5)
# CLAUDE_MODEL=claude-haiku-4-5
